# Copy to .env and fill in. .env is gitignored. Stub models need no key.
VEU_ANTHROPIC_API_KEY=
# Optional: "off" bypasses the local result cache, so you measure the engine's own resume
VEU_CACHE=on
# Optional: Temporal Cloud. Leave blank for the local dev server.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
